+// D3DVSDT_* -> (components, GL type, normalized)
+static void progvs_type(unsigned t, GLint* n, GLenum* type, GLboolean* norm) {
+    static const struct { GLint n; GLenum type; GLboolean norm; } k[8] = {
+        { 1, GL_FLOAT, GL_FALSE }, { 2, GL_FLOAT, GL_FALSE }, { 3, GL_FLOAT, GL_FALSE }, { 4, GL_FLOAT, GL_FALSE },
+        { 4, GL_UNSIGNED_BYTE, GL_TRUE }, { 4, GL_UNSIGNED_BYTE, GL_FALSE }, { 2, GL_SHORT, GL_FALSE }, { 4, GL_SHORT, GL_FALSE } };
+    unsigned i = t < 8 ? t : 3;
+    *n = k[i].n; *type = k[i].type; *norm = k[i].norm;
+}
