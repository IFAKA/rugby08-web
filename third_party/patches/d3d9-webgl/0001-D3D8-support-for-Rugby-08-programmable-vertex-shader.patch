+// D3D fixed-function light (D3DLIGHT_POINT 1, SPOT 2 as point, DIRECTIONAL 3): the material colours
+// come in from the caller (D3DRS_*MATERIALSOURCE may take them from the vertex colour).
+vec3 calcLight(int type, vec3 lightPos, vec3 lightDir, vec4 lightDiffuse, vec3 lightAmbient,
+               vec3 lightAtten, float lightRange, vec3 worldPos, vec3 worldNormal,
+               vec3 matDiffuse, vec3 matAmbient) {
+    vec3 L;
+    float atten = 1.0;
+    if (type == 3) {
+        L = normalize(-lightDir);
+    } else {
+        vec3 light_vec = lightPos - worldPos;
+        float dist = length(light_vec);
+        if (dist >= lightRange) return vec3(0.0);
+        L = light_vec / max(dist, 1e-6);
+        atten = 1.0 / max(lightAtten.x + lightAtten.y * dist + lightAtten.z * dist * dist, 1e-6);
+    }
+    float NdotL = max(dot(worldNormal, L), 0.0);
+    return (matAmbient * lightAmbient + matDiffuse * lightDiffuse.rgb * NdotL) * atten;
 }
 
