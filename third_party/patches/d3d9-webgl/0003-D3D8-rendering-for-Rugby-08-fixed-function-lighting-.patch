+        "    if (u_fog_enabled) { highp float f = clamp((u_fog_end - 1.0 / gl_FragCoord.w) / (u_fog_end - u_fog_start), 0.0, 1.0);\n"
+        "        D3D9W_OUT.rgb = mix(u_fog_color, D3D9W_OUT.rgb, f); }\n";
+    s.insert(close, tail);
+    s.insert(m, decl);
+    return s;
