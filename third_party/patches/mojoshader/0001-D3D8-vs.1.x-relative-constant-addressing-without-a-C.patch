From c0aa31281f066925b99f08a46720d76790ac1c96 Mon Sep 17 00:00:00 2001
From: Facundo Arenas <facundoarenas29@gmail.com>
Date: Sun, 11 Oct 2026 16:31:47 +0200
Subject: [PATCH 1/3] D3D8 vs.1.x: relative constant addressing without a CTAB

D3D8 vertex shaders carry no constant table, so c[a0.x + n] had no array to index. Without a CTAB,
treat it as an index into one array over the whole float constant file (96 registers in vs 1.x,
256 in 2.x) unless n falls in an array of DEF constants.
---
 mojoshader.c | 37 ++++++++++++++++++++++++++++++++++++-
 1 file changed, 36 insertions(+), 1 deletion(-)

diff --git a/mojoshader.c b/mojoshader.c
index 486d7e0..afc2c9c 100644
--- a/mojoshader.c
+++ b/mojoshader.c
@@ -751,7 +751,42 @@ static int parse_source_token(Context *ctx, SourceArgInfo *info)
         else if (info->regtype == REG_TYPE_CONST)
         {
             // figure out what array we're in...
-            if (!ctx->ignores_ctab)
+            if ((!ctx->ignores_ctab) && (!ctx->ctab.have_ctab))
+            {
+                // No CTAB (every D3D8 vs.1.x shader): c[a0.x + n] can reach any float constant,
+                //  so it reads one array over the whole constant file (96 registers in vs 1.x,
+                //  256 in vs 2.x) unless n is in an array of DEF constants.
+                determine_constants_arrays(ctx);
+                const int reltarget = info->regnum;
+                VariableList *var;
+                for (var = ctx->variables; var != NULL; var = var->next)
+                {
+                    if ((reltarget >= var->index) && (reltarget < (var->index + var->count)))
+                        break;
+                } // for
+                if (var == NULL)
+                {
+                    var = (VariableList *) Malloc(ctx, sizeof (VariableList));
+                    if (var != NULL)
+                    {
+                        var->type = MOJOSHADER_UNIFORM_FLOAT;
+                        var->index = 0;
+                        var->count = shader_version_atleast(ctx, 2, 0) ? 256 : 96;
+                        var->constant = NULL;
+                        var->used = 0;
+                        var->emit_position = -1;
+                        var->next = ctx->variables;
+                        ctx->variables = var;
+                    } // if
+                } // if
+                if (var != NULL)
+                {
+                    var->used = 1;
+                    info->relative_array = var;
+                    set_used_register(ctx, info->relative_regtype, info->relative_regnum, 0);
+                } // if
+            } // if
+            else if (!ctx->ignores_ctab)
             {
                 if (!ctx->ctab.have_ctab)  // hard to do efficiently without!
                     fail(ctx, "relative addressing unsupported without a CTAB");
